# telegram_coinglass_trader Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# API CREDENTIALS (REQUIRED)
# =============================================================================
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET=your_bybit_secret_here
BYBIT_TESTNET=true

COINGLASS_API_KEY=your_coinglass_api_key_here

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================
DEFAULT_SYMBOL=BTC/USDT:USDT
STRATEGY_ENABLED=false
LEVERAGE=10

# Enhanced Risk management for 20%+ returns
MAX_RISK_PERCENT=4.0
MAX_DAILY_LOSS=8.0
MAX_POSITIONS=5

# CoinGlass thresholds
COINGLASS_FUNDING_THRESHOLD=0.01
COINGLASS_LS_RATIO_THRESHOLD=0.65
COINGLASS_OI_CHANGE_THRESHOLD=5.0

# Technical indicators
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================
DATA_UPDATE_INTERVAL=30
STRATEGY_INTERVAL=60
POSITION_MGMT_INTERVAL=300

LOG_LEVEL=INFO
ENABLE_UVLOOP=true
